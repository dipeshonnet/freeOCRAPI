FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir paddlepaddle==3.2.0 paddleocr==3.3.2 'paddlex[serve]==3.3.2'
RUN useradd --create-home --uid 1000 ocr
USER ocr
ENV HOME=/home/ocr
EXPOSE 8080
CMD ["paddlex","--serve","--pipeline","OCR","--host","0.0.0.0","--port","8080"]
