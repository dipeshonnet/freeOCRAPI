{
  "name": "freeocrapi",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first OCR gateway with sequential provider routing",
  "author": "FreeOCRapi contributors",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "checkpoint": "node scripts/checkpoint.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:dist:win": "node scripts/desktop-prepare.mjs && node scripts/package-desktop.mjs --win --publish never",
    "desktop:dist:mac": "node scripts/desktop-prepare.mjs && node scripts/package-desktop.mjs --mac --publish never",
    "desktop:dist:linux": "node scripts/desktop-prepare.mjs && node scripts/package-desktop.mjs --linux --publish never"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-textract": "^3.1156.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@llamaindex/llama-cloud": "^2.19.0",
    "@napi-rs/canvas": "^1.0.13",
    "@tanstack/react-query": "^5.97.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.8.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "undici": "^8.12.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^3.2.4"
  }
}
